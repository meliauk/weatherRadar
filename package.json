{
  "name": "weather-radar",
  "version": "1.0.0",
  "description": "天气预报提醒系统",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "shx cp -r src/public dist/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cron": "node dist/cron.js",
    "listener": "node dist/listener.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "weather",
    "reminder",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "shx": "^0.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
